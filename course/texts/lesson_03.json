  },
  {
    "paragraph": 182,
    "text": "Слева: реагентные баки 3,0 × 4,0 м, объём 30 м³"
  },
  {
    "paragraph": 183,
    "text": "Справа: растворные ёмкости 5,0 × 6,0 м, объём 200 м³"
  },
  {
    "paragraph": 184,
    "text": "Центр: насосная зона"
  },
  {
    "paragraph": 185,
    "text": "Общая ширина: 23 500 мм"
  },
  {
    "paragraph": 186,
    "text": "📐 План 0.0 м (нижний уровень)"
  },
  {
    "paragraph": 187,
    "text": "Слева: напорные фильтры 1,8 × 5,0 м"
  },
  {
    "paragraph": 188,
    "text": "Справа: отстойники Ø6,9 м, количество: 2"
  },
  {
    "paragraph": 189,
    "text": "Общая ширина: 25 600 мм"
  },
  {
    "paragraph": 190,
    "text": "1. Минимальная площадь реакторной зоны"
  },
  {
    "paragraph": 191,
    "text": "Цель: определить необходимую площадь для размещения реакторов с учётом межоборудованного пространства, обслуживания и безопасности."
  },
  {
    "paragraph": 192,
    "text": "Формула:"
  },
  {
    "paragraph": 193,
    "text": "Aреакторной = n ⋅ (Aреактора + Aобслуживания)"
  },
  {
    "paragraph": 194,
    "text": "Пример:"
  },
  {
    "paragraph": 195,
    "text": "Количество реакторов: n=3"
  },
  {
    "paragraph": 196,
    "text": "Диаметр реактора: D=6.0 м"
  },
  {
    "paragraph": 197,
    "text": "Зона обслуживания вокруг: по 2 м с каждой стороны"
  },
  {
    "paragraph": 198,
    "text": "Aреактора= π ∙ 622"
  },
  {
    "paragraph": 199,
    "text": "Aобслуживания = (6 + 4)2 = 100 м2"
  },
  {
    "paragraph": 200,
    "text": "Aреакторной = 3 ⋅ (28,3 + 100) ≈ 385 м2"
  },
  {
    "paragraph": 201,
    "text": "2. Объём вытяжной вентиляции"
  },
  {
    "paragraph": 202,
    "text": "Цель: рассчитать необходимый воздухообмен для удаления паров H₂SO₄ и поддержания санитарных норм."
  },
  {
    "paragraph": 203,
    "text": "Формула:"
  },
  {
    "paragraph": 204,
    "text": "Qвент = Vцеха ⋅ N"
  },
  {
    "paragraph": 205,
    "text": "где:"
  },
  {
    "paragraph": 206,
    "text": "Vцеха  - объём помещения, м³"
  },
  {
    "paragraph": 207,
    "text": "N - кратность воздухообмена (обычно 6–10 для кислотных процессов)"
  },
  {
    "paragraph": 208,
    "text": "Пример:"
  },
  {
    "paragraph": 209,
    "text": "Площадь реакторной зоны: 400 м²"
  },
  {
    "paragraph": 210,
    "text": "Высота помещения: 8 м"
  },
  {
    "paragraph": 211,
    "text": "Кратность: N=8"
  },
  {
    "paragraph": 212,
    "text": "Vцеха = 400 ⋅ 8 = 3200 м3"
  },
  {
    "paragraph": 213,
    "text": "Qвент = 3200 ⋅ 8 = 25 600 м3/ч"
  },
  {
    "paragraph": 214,
    "text": "3. Требования к материалам конструкций"
  },
  {
    "paragraph": 215,
    "text": "Цель: указать, какие материалы допустимы для конструкций, контактирующих с кислотой и паром."
  },
  {
    "paragraph": 216,
    "text": "Элемент конструкции"
  },
  {
    "paragraph": 217,
    "text": "Требование"
  },
  {
    "paragraph": 218,
    "text": "Облицовка пола"
  },
  {
    "paragraph": 219,
    "text": "Кислотоупорная плитка, полимерные покрытия (эпоксидные, винилэфирные)"
  },
  {
    "paragraph": 220,
    "text": "Стены и перегородки"
  },
  {
    "paragraph": 221,
    "text": "Железобетон с антикоррозионной защитой, стеклопластик, ПВХ панели"
  },
  {
    "paragraph": 222,
    "text": "Металлоконструкции"
  },
  {
    "paragraph": 223,
    "text": "Нержавеющая сталь (AISI 316), кислотостойкие сплавы, полимерные композиты"
  },
  {
    "paragraph": 224,
    "text": "Воздуховоды и вентиляция"
  },
  {
    "paragraph": 225,
    "text": "ПП, ПВХ, PVDF, FRP (армированный стеклопластик)"
  },
  {
    "paragraph": 226,
    "text": "Трубопроводы"
  },
  {
    "paragraph": 227,
    "text": "ПВХ, ПП, HDPE, PVDF, стеклопластик"
  },
  {
    "paragraph": 228,
    "text": "Окна и световые панели"
  },
  {
    "paragraph": 229,
    "text": "Закалённое стекло с защитной плёнкой, поликарбонат"
  },
  {
    "paragraph": 230,
    "text": "Далее представлен текст программного кода для расчетов по проектированию цеха выщелачивания, который поможет при выполнении индивидуальных самостоятельных вариантов и темы для теоретических исследований. Допускается разработка собственных алгоритмов и программных кодов."
  },
  {
    "paragraph": 231,
    "text": "import math"
  },
  {
    "paragraph": 232,
    "text": "# Исходные данные"
  },
  {
    "paragraph": 233,
    "text": "G_year = 300_000        # производительность участка, т/год"
  },
  {
    "paragraph": 234,
    "text": "w_Cu = 0.015            # содержание Cu в сырье"
  },
  {
    "paragraph": 235,
    "text": "E = 0.92                # степень извлечения"
  },
  {
    "paragraph": 236,
    "text": "rho_pulp = 1.1          # плотность пульпы, т/м³"
  },
  {
    "paragraph": 237,
    "text": "tau = 6                 # время выщелачивания, ч"
  },
  {
    "paragraph": 238,
    "text": "eta = 0.75              # коэффициент загрузки реактора"
  },
  {
    "paragraph": 239,
    "text": "M_Cu = 63.5             # молярная масса Cu, г/моль"
  },
  {
    "paragraph": 240,
    "text": "M_H2SO4 = 98            # молярная масса H2SO4, г/моль"
  },
  {
    "paragraph": 241,
    "text": "C_H2SO4 = 100           # концентрация H2SO4, г/л"
  },
  {
    "paragraph": 242,
    "text": "rho_solution = 1100     # плотность раствора, кг/м³"
  },
  {
    "paragraph": 243,
    "text": "hours_year = 8760       # часов в году"
  },
  {
    "paragraph": 244,
    "text": "# Задание 1: Объем реактора"
  },
  {
    "paragraph": 245,
    "text": "G_hour = G_year / hours_year   # т/ч"
  },
  {
    "paragraph": 246,
    "text": "Q = G_hour / rho_pulp          # м³/ч"
  },
  {
    "paragraph": 247,
    "text": "V_reactor = (Q * tau) / eta    # м³"
  },
  {
    "paragraph": 248,
    "text": "print(f\"Объем реактора: {V_reactor:.1f} м³\")"
  },
  {
    "paragraph": 249,
    "text": "# Задание 2: Стехиометрический расход кислоты"
  },
  {
    "paragraph": 250,
    "text": "m_Cu_in = G_year * w_Cu        # т/год"
  },
  {
    "paragraph": 251,
    "text": "m_Cu_extr = m_Cu_in * E        # т/год"
  },
  {
    "paragraph": 252,
    "text": "n_Cu = (m_Cu_extr * 1e6) / M_Cu   # моль (перевод т -> г)"
  },
  {
    "paragraph": 253,
    "text": "m_H2SO4 = n_Cu * M_H2SO4 / 1e6    # т"
  },
  {
    "paragraph": 254,
    "text": "V_solution = (m_H2SO4 * 1e6) / (C_H2SO4 * rho_solution)  # м³"
  },
  {
    "paragraph": 255,
    "text": "print(f\"Теоретический расход H2SO4: {m_H2SO4:.1f} т\")"
  },
  {
    "paragraph": 256,
    "text": "print(f\"Реальный объем раствора: {V_solution:.1f} м³\")"
  },
  {
    "paragraph": 257,
    "text": "# Задание 3: Резервуары и насосы"
  },
  {
    "paragraph": 258,
    "text": "Q_solution = 40   # м³/ч (пример)"
  },
  {
    "paragraph": 259,
    "text": "t_res = 10        # ч"
  },
  {
    "paragraph": 260,
    "text": "V_res = Q_solution * t_res"
  },
  {
    "paragraph": 261,
    "text": "n_res = math.ceil(V_res / 200)  # резервуары по 200 м³"
  },
  {
    "paragraph": 262,
    "text": "print(f\"Количество резервуаров: {n_res}\")"
  },
  {
    "paragraph": 263,
    "text": "Q_s = Q_solution / 3600         # м³/с"
  },
  {
    "paragraph": 264,
    "text": "H = 15                          # м"
  },
  {
    "paragraph": 265,
    "text": "g = 9.81                        # м/с²"
  },
  {
    "paragraph": 266,
    "text": "eta_pump = 0.75"
  },
  {
    "paragraph": 267,
    "text": "P = (Q_s * H * rho_solution * g) / eta_pump / 1000  # кВт"
  },
  {
    "paragraph": 268,
    "text": "print(f\"Мощность насоса: {P:.2f} кВт\")"
  },
  {
    "paragraph": 269,
    "text": "# Задание 4: Фильтры и отстойники"
  },
  {
    "paragraph": 270,
    "text": "Q_liquid = 37.5   # м³/ч"
  },
  {
    "paragraph": 271,
    "text": "q_f = 0.5         # м³/(м²·ч)"
  },
  {
    "paragraph": 272,
    "text": "F = Q_liquid / q_f"
  },
  {
    "paragraph": 273,
    "text": "n_filters = math.ceil(F / 20)   # фильтры по 20 м²"
  },
  {
    "paragraph": 274,
    "text": "print(f\"Площадь фильтрования: {F:.1f} м², количество фильтров: {n_filters}\")"
  },
  {
    "paragraph": 275,
    "text": "t_settle = 3"
  },
  {
    "paragraph": 276,
    "text": "V_settle = Q_liquid * t_settle"
  },
  {
    "paragraph": 277,
    "text": "v_osad = 1.0"
  },
  {
    "paragraph": 278,
    "text": "A_settle = Q_liquid / v_osad"
  },
  {
    "paragraph": 279,
    "text": "D_settle = math.sqrt(4 * A_settle / math.pi)"
  },
  {
    "paragraph": 280,
    "text": "n_settle = math.ceil(V_settle / 60)  # отстойники по 60 м³"
  },
  {
    "paragraph": 281,
    "text": "print(f\"Диаметр отстойника: {D_settle:.1f} м, количество отстойников: {n_settle}\")"
  },
  {
    "paragraph": 282,
    "text": "# Задание 5: Архитектурные параметры"
  },
  {
    "paragraph": 283,
    "text": "D_reactor = 6.0"
  },
  {
    "paragraph": 284,
    "text": "A_reactor = math.pi * (D_reactor/2)**2"
  },
  {
    "paragraph": 285,
    "text": "A_service = (D_reactor + 4)**2"
  },
  {
    "paragraph": 286,
    "text": "A_zone = 3 * (A_reactor + A_service)"
  },
  {
    "paragraph": 287,
    "text": "print(f\"Минимальная площадь реакторной зоны: {A_zone:.1f} м²\")"
  },
  {
    "paragraph": 288,
    "text": "H_building = 8"
  },
  {
    "paragraph": 289,
    "text": "V_building = 400 * H_building"
  },
  {
    "paragraph": 290,
    "text": "N_air = 8"
  },
  {
    "paragraph": 291,
    "text": "Q_air = V_building * N_air"
  },
  {
    "paragraph": 292,
    "text": "print(f\"Объем вытяжной вентиляции: {Q_air:.0f} м³/ч\")"
  },
